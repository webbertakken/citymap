{
  "name": "citymap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --max-warnings 0",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run coverage"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,jsx,mjs,json,jsonc,md,yml,yaml,toml,css}": "oxfmt --write --no-error-on-unmatched-pattern",
    "*.{ts,tsx,mts,js,jsx,mjs}": "oxlint --type-aware --max-warnings 0",
    "*.{sh,bash}": "shellcheck",
    ".github/workflows/*.{yml,yaml}": "actionlint"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@vitest/coverage-v8": "5.0.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
