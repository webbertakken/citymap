{
  "name": "citymap",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "typecheck": "bun scripts/check-references.ts && tsc --build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "bench": "bun scripts/bench.ts",
    "parity": "bun scripts/parity.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run coverage"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc,json5,md,mdx,yml,yaml,toml,css,scss,less,html}": "oxfmt --write --no-error-on-unmatched-pattern",
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": "oxlint --no-error-on-unmatched-pattern",
    "*.{sh,bash}": "shellcheck",
    ".husky/pre-*": "shellcheck",
    ".github/workflows/*.{yml,yaml}": "actionlint"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@citymap/ground-plan": "workspace:*",
    "@citymap/history": "workspace:*",
    "@citymap/svg": "workspace:*",
    "@citymap/themes": "workspace:*"
  }
}
