{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../node_modules/.cache/tsc/web",
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/web.tsbuildinfo",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["src", "e2e", "*.ts"],
  "exclude": ["node_modules", ".next", "out"],
  "references": [
    { "path": "../../packages/ground-plan" },
    { "path": "../../packages/history" },
    { "path": "../../packages/scene" },
    { "path": "../../packages/themes" }
  ]
}
